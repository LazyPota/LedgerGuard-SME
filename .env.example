# Runtime settings. All optional; offline mode needs none of these.
TENANT_ID=sme_01
OFFLINE_DETERMINISTIC_MODE=true
POLICY_VERSION=2026.1

# Tier 2 bounded auto-execution.
TIER2_SINGLE_PAYMENT_CAP=2500.00
TIER2_DAILY_PAYMENT_CAP=5000.00

# Fail-closed extraction confidence floor.
EXTRACTION_CONFIDENCE_FLOOR=0.8500

# Optional zero-tool LLM extraction. Never called in offline mode.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini

# Storage.
DATABASE_PATH=ledgerguard.db
AUDIT_LOG_PATH=evidence/forensic_audit_log.jsonl

# Used by the evidence scripts/tests to isolate runs.
# LEDGERGUARD_DB_PATH=evidence/sandbox_ledger.db
# LEDGERGUARD_STARTING_CASH=77200.00

# MUST be overridden outside local development.
APPROVAL_SIGNING_SECRET=dev-only-change-me
